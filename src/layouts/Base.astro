---
// 모든 페이지가 쓰는 바깥 틀: <html>, <head>, 헤더(메뉴와 언어 전환), 본문 자리.
import '../styles/tokens.css'
import { DEFAULT_LOCALE, LOCALES, type Locale, localePath, splitLocale } from '../i18n/paths'
import { t } from '../i18n/ui'

interface Props {
  title: string
  description?: string
  locale: Locale
  /** 다른 언어판이 없는 페이지(404)는 false. 기본값 true. */
  translated?: boolean
  /**
   * 언어마다 다른 글이 짝인 경우(옛 글의 x와 x-ko)에만 넘긴다. 언어 없는 경로를 적는다.
   * 넘기지 않으면 같은 경로의 /ko/ 판이 짝이다.
   */
  alternatePaths?: Partial<Record<Locale, string>>
}

const { title, description, locale, translated = true, alternatePaths = {} } = Astro.props

// 지금 주소에서 언어 없는 경로를 얻는다. 예: '/ko/cv/' → '/cv/'
const current = splitLocale(Astro.url.pathname)
if (translated && current.locale !== locale) {
  // 라우트 파일이 언어를 잘못 넘긴 경우를 빌드에서 잡는다.
  throw new Error(`${Astro.url.pathname} is a "${current.locale}" route but got locale="${locale}"`)
}

const other: Locale = locale === 'en' ? 'ko' : 'en'
const pagePath = translated ? current.path : '/'
// 그 언어로 이 페이지를 읽으려면 가야 할 주소
const hrefFor = (target: Locale) => localePath(target, alternatePaths[target] ?? pagePath)
const absolute = (href: string) => new URL(href, Astro.site).href

// 배포 뒤 smoke.sh가 이 값으로 "방금 올린 빌드가 맞는지" 확인한다.
const buildSha = import.meta.env.BUILD_SHA ?? 'dev'
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="build" content={buildSha} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {
      translated && (
        <>
          {LOCALES.map((target) => (
            <link rel="alternate" hreflang={target} href={absolute(hrefFor(target))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(hrefFor(DEFAULT_LOCALE))} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title="Woorim Shin" href="/feed.xml" />
  </head>
  <body>
    <header>
      <a class="name" href={localePath(locale, '/')}>Woorim Shin</a>
      <nav>
        <a href={localePath(locale, '/cv/')}>{t(locale, 'nav.cv')}</a>
        <a href={localePath(locale, '/blog/')}>{t(locale, 'nav.blog')}</a>
        <a class="lang" href={hrefFor(other)} lang={other} hreflang={other}>
          {t(locale, 'lang.switch')}
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  header,
  main {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-thin) solid var(--color-line);
  }
  header a {
    text-decoration: none;
  }
  header a:hover {
    text-decoration: underline;
  }
  .name {
    font-weight: 600;
  }
  nav {
    display: flex;
    gap: var(--space-5);
  }
  .lang {
    color: var(--color-fg-muted);
  }
  main {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }
</style>
