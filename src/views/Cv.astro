---
// CV 화면. 내용은 content/resume.json에서 오고, 영어로만 있다.
import Base from '../layouts/Base.astro'
import type { Locale } from '../i18n/paths'
import { t } from '../i18n/ui'
import { loadResume } from '../lib/cv/resume'
import { formatPeriod } from '../lib/format'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const resume = loadResume()

// resume.json의 날짜는 'YYYY-MM-DD'까지 올 수 있다. 기간 표시는 달까지만 쓴다.
const month = (value: string) => (value === 'Present' ? value : value.slice(0, 7))
// 학력·경력: 끝이 비어 있으면 지금도 진행 중이다.
const span = (start: string, end?: string) =>
  formatPeriod({ start: month(start), end: end ? month(end) : undefined }, locale)
// 발표: 끝이 비어 있으면 하루짜리 일이라 시작만 적는다.
const when = (start: string, end?: string) => formatPeriod({ start: month(start), end: month(end ?? start) }, locale)
---

<Base
  title={`CV — ${resume.basics.name}`}
  description="Education, experience, publications and talks."
  locale={locale}
>
  {locale === 'ko' && <p class="notice">{t(locale, 'cv.contentInEnglish')}</p>}

  <!-- 본문은 영어라서, 한국어 화면에서도 이 부분의 언어는 en이다. -->
  <div lang="en">
    <h1>{resume.basics.name}</h1>
    <p class="muted">{resume.basics.label}</p>
    <p class="contact">
      <a href={`mailto:${resume.basics.email}`}>{resume.basics.email}</a>
      {
        resume.basics.profiles?.map((profile) => (
          <a href={profile.url} rel="me noopener">
            {profile.network}
          </a>
        ))
      }
    </p>
    <p>{resume.basics.summary}</p>
  </div>

  <section>
    <h2>{t(locale, 'cv.education')}</h2>
    <div lang="en">
      {
        resume.education.map((entry) => (
          <div class="entry">
            <p class="head">
              {entry.studyType}, {entry.area}
            </p>
            <p class="meta">
              {entry.institution} — <span lang={locale}>{span(entry.startDate, entry.endDate)}</span>
            </p>
            {entry.courses?.length ? <p class="meta">Coursework: {entry.courses.join(', ')}</p> : null}
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>{t(locale, 'cv.experience')}</h2>
    <div lang="en">
      {
        resume.work.map((job) => (
          <div class="entry">
            <p class="head">
              {job.position} — {job.name}
            </p>
            <p class="meta">
              {job.location ? `${job.location} — ` : ''}
              <span lang={locale}>{span(job.startDate, job.endDate)}</span>
            </p>
            <ul>
              {job.highlights.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>{t(locale, 'cv.publications')}</h2>
    <div lang="en">
      {
        resume.publications.map((paper) => (
          <div class="entry">
            <p class="head">{paper.name}</p>
            <p class="meta">
              {paper.publisher} — {paper.releaseDate}
            </p>
            <p class="small">{paper.summary}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>{t(locale, 'cv.talks')}</h2>
    <div lang="en">
      {
        resume.talks.map((talk) => (
          <div class="entry">
            <p class="head">
              {talk.title}
              {talk.slides ? (
                <>
                  {' '}
                  <a class="small" href={talk.slides}>
                    (slides)
                  </a>
                </>
              ) : null}
            </p>
            <p class="meta">
              {talk.venue} — <span lang={locale}>{when(talk.startDate, talk.endDate)}</span>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>{t(locale, 'cv.awards')}</h2>
    <ul lang="en">
      {
        resume.awards.map((award) => (
          <li>
            {award.title} <span class="muted">({award.date})</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>{t(locale, 'cv.skills')}</h2>
    <div lang="en">
      {
        resume.skills.map((group) => (
          <p class="skill">
            <span class="head">{group.name}:</span> <span class="muted">{group.keywords.join(', ')}</span>
          </p>
        ))
      }
    </div>
  </section>

  <section>
    <h2>{t(locale, 'cv.languages')}</h2>
    <p class="muted" lang="en">
      {resume.languages.map((l) => `${l.language} (${l.fluency})`).join(', ')}
    </p>
  </section>
</Base>

<style>
  h1 {
    margin: 0;
    font-size: 1.75rem;
  }
  h2 {
    margin: var(--space-7) 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-thin) solid var(--color-line);
    font-size: 1.125rem;
  }
  p {
    margin: var(--space-2) 0 0;
  }
  ul {
    margin: var(--space-2) 0 0;
    padding-left: 1.25rem;
  }
  li {
    margin-top: var(--space-1);
  }
  .notice {
    margin: 0 0 var(--space-5);
    color: var(--color-fg-muted);
    font-size: 0.875rem;
  }
  .muted,
  .meta {
    color: var(--color-fg-muted);
  }
  .meta,
  .small {
    font-size: 0.875rem;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
    font-size: 0.875rem;
  }
  .entry + .entry {
    margin-top: var(--space-5);
  }
  .head {
    font-weight: 600;
  }
  .skill {
    margin-top: var(--space-2);
  }
</style>
