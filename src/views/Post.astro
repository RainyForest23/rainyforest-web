---
// 글 한 편. 화면 언어(locale)와 글의 언어(entry.data.lang)가 다를 수 있다.
import { type CollectionEntry, getCollection, render } from 'astro:content'
// 수식 글꼴과 배치. 수식은 글 화면에만 있으므로 여기서만 싣는다.
import 'katex/dist/katex.min.css'
import '../styles/prose.css'
import Base from '../layouts/Base.astro'
import { type Locale, localePath } from '../i18n/paths'
import { t } from '../i18n/ui'
import { translationOf } from '../lib/content/legacy'
import { formatDate } from '../lib/format'

interface Props {
  locale: Locale
  entry: CollectionEntry<'legacy'>
}

const { locale, entry } = Astro.props
const { title, summary_en, lang, date, updated, tags } = entry.data
// MDX 본문을 화면에 넣을 수 있는 컴포넌트로 바꾼다.
const { Content } = await render(entry)

// 같은 글의 다른 언어판이 있으면(x와 x-ko) 언어 전환과 안내가 그쪽을 가리킨다.
const ids = (await getCollection('legacy')).map((post) => post.id)
const twin = translationOf(entry.id, ids)
const otherLang: Locale = lang === 'ko' ? 'en' : 'ko'
const alternatePaths = twin ? { [lang]: `/blog/${entry.id}/`, [otherLang]: `/blog/${twin}/` } : undefined
---

<Base title={`${title} — Woorim Shin`} description={summary_en} locale={locale} alternatePaths={alternatePaths}>
  <p class="meta">
    <time datetime={date}>{formatDate(date, locale)}</time>
    {
      updated && updated !== date && (
        <span>
          {' '}
          — {t(locale, 'post.updated')} <time datetime={updated}>{formatDate(updated, locale)}</time>
        </span>
      )
    }
  </p>
  <h1 lang={lang}>{title}</h1>

  {
    locale !== lang && twin && (
      <p class="notice">
        {t(locale, 'post.hasTranslation')}{' '}
        <a href={localePath(locale, `/blog/${twin}/`)}>{t(locale, 'post.readTranslation')}</a>
      </p>
    )
  }
  {
    locale !== lang && !twin && lang === 'ko' && (
      <p class="notice">
        {t(locale, 'post.koreanOnly')} <span>{summary_en}</span>
      </p>
    )
  }
  {locale !== lang && !twin && lang === 'en' && <p class="notice">{t(locale, 'post.englishOnly')}</p>}

  {
    tags.length > 0 && (
      <p class="tags">
        {tags.map((tag) => (
          <a href={localePath(locale, `/blog/tags/${tag}/`)}>#{tag}</a>
        ))}
      </p>
    )
  }

  <article class="prose-body" lang={lang}>
    <Content />
  </article>
</Base>

<style>
  .meta {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: 0.875rem;
  }
  h1 {
    margin: var(--space-2) 0 0;
    font-size: 1.75rem;
    line-height: 1.3;
  }
  .notice {
    margin: var(--space-4) 0 0;
    border-left: var(--border-thick) solid var(--color-line);
    padding-left: var(--space-4);
    color: var(--color-fg-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-4) 0 0;
    color: var(--color-fg-muted);
    font-size: 0.875rem;
  }
  .tags a {
    text-decoration: none;
  }
  .tags a:hover {
    text-decoration: underline;
  }
  article {
    margin-top: var(--space-6);
  }
</style>
