{
  "name": "rainyforest-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:links": "tsx scripts/check-links.ts",
    "verify": "npm run check:tokens && npm test && npm run build && npm run check:links && npm run typecheck",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.141.0"
  }
}
